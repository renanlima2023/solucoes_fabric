      {
        "name": "Filtro Clientes",
        "description": "Filtrar as informações referente a tabela clientes",
        "type": "Filter",
        "dependsOn": [
          {
            "activity": "Orquestrador",
            "dependencyConditions": [
              "Succeeded"
            ]
          }
        ],
        "typeProperties": {
          "items": {
            "value": "@activity('Orquestrador').output.value",
            "type": "Expression"
          },
          "condition": {
            "value": "@and(\n    equals(item().TargetTable, 'Customers'),\n    equals(item().Flag, '1')\n    )",
            "type": "Expression"
          }
        }
      },
